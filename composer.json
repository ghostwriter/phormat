{
    "name": "ghostwriter/phormat",
    "description": "PHP code formatter",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "ghostwriter",
        "phormat",
        "dev"
    ],
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ghostwriter/phormat",
    "support": {
        "issues": "https://github.com/ghostwriter/phormat/issues",
        "source": "https://github.com/ghostwriter/phormat",
        "rss": "https://github.com/ghostwriter/phormat/releases.atom",
        "security": "https://github.com/ghostwriter/phormat/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/codepoet"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-mbstring": "*",
        "ghostwriter/case-converter": "^2.2.2",
        "ghostwriter/container": "^7.0.2",
        "ghostwriter/event-dispatcher": "^6.1.3",
        "ghostwriter/filesystem": "^0.2.1",
        "nikic/php-parser": "^5.8.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "ghostwriter/coding-standard": "dev-main",
        "phpunit/phpunit": "^13.3.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ghostwriter\\Phormat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/bootstrap.php"
        ],
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "bin": [
        "bin/phormat"
    ],
    "config": {
        "allow-plugins": {
            "ghostwriter/coding-standard": true
        },
        "bump-after-update": false,
        "classmap-authoritative": false,
        "discard-changes": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.999"
        },
        "platform-check": true,
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "prepend-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "strict-psr-autoloader": true,
        "use-parent-dir": false
    },
    "extra": {
        "thanks": {
            "name": "ghostwriter/phormat",
            "url": "https://github.com/ghostwriter/phormat"
        }
    },
    "scripts": {
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "@composer validate",
            "@test"
        ],
        "infection": [
            "@xdebug",
            "infection --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "phormat": "bin/phormat --fix --dry-run",
        "phpunit": [
            "@xdebug",
            "phpunit --colors=always"
        ],
        "test": [
            "@phpunit",
            "@infection"
        ],
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
